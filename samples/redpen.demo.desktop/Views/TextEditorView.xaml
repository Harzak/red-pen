<UserControl x:Class="redpen.demo.desktop.Views.TextEditorView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <avalon:TextEditor Grid.Row="0" WordWrap="True" ShowLineNumbers="False" />
        <StackPanel Grid.Row="1">
            <Button Content="{Binding CorrectButtonLabel}" Command="{Binding CorrectCommand}" />
            <TextBlock Text="{Binding ErrorMessage}" />
        </StackPanel>
        <TextBox Grid.Row="2" Text="{Binding CorrectedText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
    </Grid>
</UserControl>
